<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-process adapter around the vendor VisualCron API (.NET Framework 4.8 + WCF).
       It is the ONLY component that loads VisualCronAPI.dll. It talks newline-delimited JSON over stdin/stdout
       with the MCP host. Vendor DLLs are referenced for compilation only (Private=false) and resolved at runtime
       from the VisualCron install directory, so the bridge always matches the installed VisualCron version. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>VisualCronAI.Bridge</RootNamespace>
    <AssemblyName>VisualCronAI.Bridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualCronAI.Contracts\VisualCronAI.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VisualCronAI.Bridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VisualCronAPI">
      <HintPath>$(VisualCronInstallDir)\VisualCronAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VisualCron">
      <HintPath>$(VisualCronInstallDir)\VisualCron.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
