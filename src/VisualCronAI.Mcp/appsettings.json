{
  // VisualCronAI MCP server configuration. NO SECRETS IN THIS FILE.
  // Per-user overrides: %APPDATA%\VisualCronAI\appsettings.json (same shape) - put real host names there.
  // An empty Address means "not configured": the server refuses to connect rather than guessing a host.
  //
  // Layout: one VisualCron server hosts DEV, UAT and PROD as job groups ("DEV: ADF-D365 Loads", "UAT: ...", "PROD: ...").
  // Each environment uses the SAME Address and is scoped by JobGroups; writes are fenced by WritableJobGroups.
  "VisualCronAI": {
    "VisualCronInstallDir": "C:\\Program Files (x86)\\VisualCron",
    "BridgePath": "",
    "BridgeRequestTimeoutSeconds": 120,
    "DefaultEnvironment": "DEV",

    "Environments": {
      "DEV": {
        "Address": "",
        "Port": 16444,
        "AuthMode": "AD",
        "CredentialTarget": "",
        "IsProduction": false,
        "AllowWrites": true,
        "JobGroups": [ "DEV:*" ],
        "WritableJobGroups": [ "DEV:*" ],
        "AdfRunnerPath": "C:\\VisualCronAI\\adf-runner\\VisualCronAI.AdfRunner.exe",
        "AdfEnvironment": "DEV",
        "DefaultJobGroup": "DEV: ADF-D365 Loads",
        "EnvironmentTokens": [ "DEV:", "_DEV", "-DEV" ]
      },
      "UAT": {
        "Address": "",
        "Port": 16444,
        "AuthMode": "AD",
        "IsProduction": false,
        "AllowWrites": false,
        "JobGroups": [ "UAT:*" ],
        "WritableJobGroups": [ "UAT:*" ],
        "AdfRunnerPath": "C:\\VisualCronAI\\adf-runner\\VisualCronAI.AdfRunner.exe",
        "AdfEnvironment": "UAT",
        "DefaultJobGroup": "UAT: ADF-D365 Loads",
        "EnvironmentTokens": [ "UAT:", "_UAT", "-UAT" ]
      },
      "PROD": {
        "Address": "",
        "Port": 16444,
        "AuthMode": "AD",
        "IsProduction": true,
        "AllowWrites": false,
        "JobGroups": [ "PROD:*" ],
        "WritableJobGroups": [ "PROD:*" ],
        "AdfRunnerPath": "C:\\VisualCronAI\\adf-runner\\VisualCronAI.AdfRunner.exe",
        "AdfEnvironment": "PROD",
        "DefaultJobGroup": "PROD: ADF-D365 Loads",
        "EnvironmentTokens": [ "PROD:", "_PROD", "-PROD" ]
      }
    },

    "Approval": {
      "Mode": "Auto",
      "ProposalTtlMinutes": 60,
      "ApprovalTtlMinutes": 15,
      "DialogTimeoutSeconds": 300,
      "ProductionApprovers": []
    },

    "Audit": {
      "Directory": ""
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "ModelContextProtocol": "Warning"
    }
  }
}
