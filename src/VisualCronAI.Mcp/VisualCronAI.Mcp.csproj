<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MCP server (STDIO transport). Started by Claude Code / VS Code Copilot. Talks to VisualCron only through
       the bridge process published into .\bridge next to this executable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisualCronAI.Mcp</RootNamespace>
    <AssemblyName>VisualCronAI.Mcp</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualCronAI.Core\VisualCronAI.Core.csproj" />
    <ProjectReference Include="..\VisualCronAI.Infrastructure\VisualCronAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="VisualCronAI.Tests" />
  </ItemGroup>
</Project>
