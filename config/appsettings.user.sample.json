{
  // Per-user configuration for the VisualCronAI MCP server. NO SECRETS IN THIS FILE.
  // setup.ps1 copies this to %APPDATA%\VisualCronAI\appsettings.json (only if that file does not exist yet).
  // Replace every <...> placeholder. Ask your team for the server name and the ADF factory details.
  //
  // Layout: ONE VisualCron server hosts DEV, UAT and PROD as job groups ("DEV: ADF-D365 Loads", "UAT: ...", "PROD: ...").
  // All three environments use the SAME Address and are separated by JobGroups. Writes are fenced by WritableJobGroups.
  // Start with UAT/PROD AllowWrites=false. Turn UAT on yourself only when you need it. Never turn PROD on casually.
  "VisualCronAI": {
    "Environments": {
      "DEV": {
        "Address": "<your-visualcron-server.domain.com>",
        "AuthMode": "CredentialManager",
        "CredentialTarget": "VisualCronAI/VCSERVER",
        "AllowWrites": true,
        "JobGroups": [ "DEV:*", "DEV :*", "DEV-*" ],
        "WritableJobGroups": [ "DEV: ADF*" ],
        "AdfSubscriptionId": "<azure-subscription-guid>",
        "AdfResourceGroup": "<dev-adf-resource-group>",
        "AdfFactoryName": "<dev-adf-factory-name>",
        "AdfTemplateJob": "Products - Trigger ADF"
      },
      "UAT": {
        "Address": "<your-visualcron-server.domain.com>",
        "AuthMode": "CredentialManager",
        "CredentialTarget": "VisualCronAI/VCSERVER",
        "AllowWrites": false,
        "JobGroups": [ "UAT:*", "UAT :*" ],
        "WritableJobGroups": [ "UAT: ADF*" ],
        "AdfSubscriptionId": "<azure-subscription-guid>",
        "AdfResourceGroup": "<uat-adf-resource-group>",
        "AdfFactoryName": "<uat-adf-factory-name>",
        "AdfTemplateJob": "Devices - Trigger ADF"
      },
      "PROD": {
        "Address": "<your-visualcron-server.domain.com>",
        "AuthMode": "CredentialManager",
        "CredentialTarget": "VisualCronAI/VCSERVER",
        "AllowWrites": false,
        "JobGroups": [ "PROD:*", "PROD :*", "PROD;*", "PROD ;*" ]
      }
    }
  }
}
